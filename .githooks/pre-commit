#!/bin/sh
# Pantallita safety hook: never commit secrets or private capture data.
# Installed with: .venv\Scripts\python scripts\install_hooks.py  (sets core.hooksPath=.githooks)

staged=$(git diff --cached --name-only --diff-filter=ACMR)
status=0

block() {
    echo "pre-commit: BLOCKED $1" >&2
    status=1
}

for f in $staged; do
    base=$(basename "$f")
    case "$base" in
        .env.example) ;;
        .env|.env.*) block "'$f' (secrets file)" ;;
    esac
    case "$f" in
        buffer/*|*/buffer/*) block "'$f' (private capture data in buffer/)" ;;
        *.wav|*.sqlite|*.sqlite3|*.db|*.jsonl) block "'$f' (private data file type)" ;;
    esac
done

# Block any staged line containing a secret value from the local .env (values are never printed).
if [ -f .env ]; then
    values=$(sed -n 's/^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=[[:space:]]*//p' .env \
        | tr -d '\r' | sed "s/^[\"']//; s/[\"']\$//" | awk 'length($0) >= 16')
    if [ -n "$values" ]; then
        added=$(git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++')
        echo "$values" | while IFS= read -r v; do
            if printf '%s\n' "$added" | grep -qF -- "$v"; then
                echo "pre-commit: BLOCKED a staged change contains a secret value from .env" >&2
                exit 1
            fi
        done || status=1
    fi
fi

# Block lines that look like credentials, whatever file they are in (.env.example is exempt).
key_like='(api[_-]?key|secret|token|password)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][A-Za-z0-9_.+/=-]{20,}["'"'"']|Bearer [A-Za-z0-9_.+/=-]{20,}|(^|[^A-Za-z0-9])(sk|pk|rk)-[A-Za-z0-9_-]{20,}'
for f in $staged; do
    [ "$(basename "$f")" = ".env.example" ] && continue
    if git diff --cached -U0 --no-color -- "$f" | grep '^+' | grep -v '^+++' | grep -qiE -- "$key_like"; then
        block "'$f' (a staged line looks like an API key or token)"
    fi
done

if [ $status -ne 0 ]; then
    echo "pre-commit: commit aborted. Unstage those files (git restore --staged <file>)." >&2
fi
exit $status
